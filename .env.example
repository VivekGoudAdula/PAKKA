# ──────────────────────────────────────────────────
# Pakka — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets.
# ──────────────────────────────────────────────────

# ── Gnani Vachana API ───────────────────────────────
GNANI_API_KEY=your_gnani_api_key_here
GNANI_DRY_RUN=false # Default to live mode if keys present; set to true for offline dry-run
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=hi-IN,en-IN
GNANI_STT_SAMPLE_RATE=8000
GNANI_STT_VAD_THRESHOLD=0.7
GNANI_STT_MIN_SPEECH_MS=200
GNANI_STT_MIN_SILENCE_MS=500
VAD_ENERGY_THRESHOLD=600.0
GNANI_STT_FORMAT=codemix
GNANI_STT_KEYTERMS=geyser,tap,leak,motor,pipe,bathroom,kitchen

GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Poorvi
GNANI_TTS_LANGUAGE=hi-en
GNANI_TTS_SPEED=1.0
GNANI_STT_REST_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_REST_URL=https://api.vachana.ai/api/v1/tts/inference
MAX_GNANI_CALLS_PER_HOUR=150

# ── Exotel Telephony ────────────────────────────────
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_ACCOUNT_SID=your_exotel_sid_here
EXOTEL_SUBDOMAIN=api.in.exotel.com
PUBLIC_WSS_URL=wss://your-ngrok-or-domain.ngrok-free.app

# ── Evon LLM (self-hosted via vLLM) ─────────────────
EVON_BASE_URL=http://localhost:8001/v1

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./pakka.db

# ── Outbound call window (IST 24-hour format) ────────
OUTBOUND_HOURS_START=9
OUTBOUND_HOURS_END=20

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
APP_ENV=development
SECRET_KEY=change_me_to_a_random_64_char_string
