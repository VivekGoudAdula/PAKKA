# ──────────────────────────────────────────────────
# Pakka — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets.
# ──────────────────────────────────────────────────

# ── Gnani Vachana API ───────────────────────────────
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts

# ── Exotel Telephony ────────────────────────────────
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SID=your_exotel_sid_here
EXOTEL_SUBDOMAIN=your_exotel_subdomain_here

# ── Evon LLM (self-hosted via vLLM) ─────────────────
EVON_BASE_URL=http://localhost:8001/v1

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./pakka.db

# ── Outbound call window (IST 24-hour format) ────────
OUTBOUND_HOURS_START=9
OUTBOUND_HOURS_END=20

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
APP_ENV=development
SECRET_KEY=change_me_to_a_random_64_char_string

